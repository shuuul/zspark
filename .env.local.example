# Copy to .env.local and uncomment the settings for this machine.
# Use literal KEY=value lines. Omit quotes and use absolute paths.

# The other Spark's direct-link IPv4 address and its checkout path.
#PEER=198.51.100.2
#PEER_REPO=/home/example/repo/zspark

# Protect the model service's LAN listener from benchmark scripts.
#MODEL_LAN_HOST=192.0.2.114
#MODEL_LAN_PORT=8888

# Explicit opt-in settings for client_bench.sh ... sparkdash.
#SPARKDASH_HOST=192.0.2.227
#SPARKDASH_URL=http://192.0.2.1:5555
#SPARKDASH_SPARK=spark-b

# Optional settings for spark_copy.sh.
#SPARK_SSH=ssh -o HostKeyAlias=192.0.2.227
#SPARK_SOURCE=198.51.100.1
